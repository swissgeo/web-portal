{
  "name": "@swissgeo/dimension",
  "version": "1.0.0",
  "description": "Dimension state and time-slider UI for SWISSGEO projects.",
  "keywords": [],
  "license": "BSD-3-Clause",
  "author": "",
  "type": "module",
  "imports": {
    "#*": "./src/*.ts",
    "#*.vue": "./src/*.vue"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "format": "prettier --check --ignore-path ../../.prettierignore .",
    "format:write": "prettier --write --ignore-path ../../.prettierignore .",
    "lint": "eslint",
    "lint:write": "eslint --fix",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "type-check": "vue-tsc"
  },
  "dependencies": {
    "@swissgeo/log": "workspace:*",
    "@swissgeo/numbers": "workspace:*"
  },
  "devDependencies": {
    "@swissgeo/config-eslint": "workspace:*",
    "@swissgeo/config-typescript": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "eslint": "catalog:",
    "pinia": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "@lucide/vue": "catalog:",
    "@nuxt/ui": "catalog:",
    "@vueuse/core": "catalog:",
    "pinia": "catalog:",
    "vue": "catalog:",
    "vue-i18n": "catalog:"
  },
  "packageManager": "pnpm@11.8.0"
}
