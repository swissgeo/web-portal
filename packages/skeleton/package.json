{
  "name": "@swissgeo/skeleton",
  "version": "0.0.1",
  "description": "",
  "keywords": [],
  "license": "BSD-3-Clause",
  "type": "module",
  "imports": {
    "#*": "./src/*.ts",
    "#*.svg": "./src/*.svg",
    "#*.vue": "./src/*.vue"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "format": "prettier --check --ignore-path ../../.prettierignore .",
    "format:write": "prettier --write --ignore-path ../../.prettierignore .",
    "lint": "eslint",
    "lint:write": "eslint --fix",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "type-check": "vue-tsc"
  },
  "dependencies": {
    "@lucide/vue": "catalog:",
    "@swissgeo/coordinates": "workspace:*",
    "@swissgeo/layers": "workspace:*",
    "@swissgeo/log": "workspace:*",
    "@swissgeo/ogc": "workspace:*",
    "@swissgeo/search": "workspace:*",
    "@swissgeo/shared": "workspace:*",
    "ufo": "catalog:"
  },
  "devDependencies": {
    "@swissgeo/config-eslint": "workspace:*",
    "@swissgeo/config-typescript": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "@nuxt/ui": "catalog:",
    "@vueuse/core": "catalog:",
    "pinia": "catalog:",
    "vue": "catalog:",
    "vue-i18n": "catalog:",
    "vue-router": "catalog:"
  },
  "packageManager": "pnpm@11.8.0"
}
