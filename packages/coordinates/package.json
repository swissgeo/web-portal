{
  "name": "@swissgeo/coordinates",
  "version": "1.0.6",
  "description": "Projection definition and coordinates utils for SWISSGEO projects.",
  "license": "BSD-3-Clause",
  "type": "module",
  "imports": {
    "#*": "./src/*.ts",
    "#*.vue": "./src/*.vue"
  },
  "exports": {
    ".": "./src/index.ts",
    "./ol": "./src/ol.ts"
  },
  "scripts": {
    "demo": "vite",
    "format": "prettier --check --ignore-path ../../.prettierignore .",
    "format:write": "prettier --write --ignore-path ../../.prettierignore .",
    "lint": "eslint",
    "lint:write": "eslint --fix",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "@swissgeo/log": "workspace:*",
    "@swissgeo/numbers": "workspace:*",
    "@swissgeo/shared": "workspace:*",
    "@turf/turf": "catalog:",
    "es-toolkit": "catalog:"
  },
  "devDependencies": {
    "@swissgeo/config-eslint": "workspace:*",
    "@swissgeo/config-typescript": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/geojson": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "eslint": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-vue-devtools": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "ol": "catalog:",
    "proj4": "catalog:"
  },
  "optionalDependencies": {
    "ol": "catalog:"
  }
}
